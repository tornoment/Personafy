<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/personafy_black</item>
        <item name="colorPrimaryDark">@color/personafy_black</item>
        <item name="colorAccent">@color/personafy_red</item>
        <item name="android:windowBackground">@color/personafy_black</item>
    </style>

    <!-- The player's window (BridgeActivity switches to it): black behind the page and the system bars. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/personafy_black</item>
        <item name="android:navigationBarColor">@color/personafy_black</item>
        <item name="android:statusBarColor">@color/personafy_black</item>
    </style>

    <!-- Start-up: the hat on black (Android 12+ draws it itself from these; older ones show the splash drawable). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/personafy_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
