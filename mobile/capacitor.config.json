{
  "appId": "com.tornoment.personafy",
  "appName": "Personafy",
  "webDir": "www",
  "backgroundColor": "#0b0b0b",
  "loggingBehavior": "none",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#0b0b0b",
    "allowsLinkPreview": false
  },
  "android": {
    "backgroundColor": "#0b0b0b",
    "allowMixedContent": false,
    "captureInput": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  }
}
